ction. Push to main to trigger a build. Firmware artifacts are available under Actions.\nFlashing\n\nEnter bootloader (double-tap reset on XIAO BLE)\nCopy the .uf2 file to the mounted mass-storage device\nDevice resets automatically\n\nFirst flash\nLeft half must be flashed first. Label controllers before soldering.\n"},"keymap.html":{"url":"keymap.html","title":"Keymap","keywords":"","body":"Keymap\nBase Layer\n┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓\n┃     Q     ┃     W     ┃     E     ┃     R     ┃     T     ┃   ┃     Z     ┃     U     ┃     I     ┃     O     ┃     P     ┃\n┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫\n┃     A     ┃     S     ┃     D     ┃     F     ┃     G     ┃   ┃     H     ┃     J     ┃     K     ┃     L     ┃     -     ┃\n┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫\n┃  LSHIFT   ┃     Y     ┃     X     ┃     C     ┃     V     ┃   ┃     B     ┃     N     ┃     M     ┃     ,     ┃     .     ┃\n┃           ┃           ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃     ;     ┃     :     ┃\n┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛\n                                     ┃  CAPS     ┃  MO(1)    ┃  ESC      ┃   ┃  SPACE    ┃  MO(2)    ┃  ENTER    ┃\n                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛\nLayer Scheme\n\n\n\nLayer\nTrigger\nPurpose\n\n\n\n\nBASE (0)\ndefault\nAlpha keys\n\n\nNAV (1)\nhold left thumb\nNavigation, media, F-keys, Bluetooth\n\n\nSYM (2)\nhold right thumb\nSymbols, numbers, brightness\n\n\nMOO (3)\nhold both thumbs\nMouse keys\n\n\n\nVisual Editor\n\n"}}}